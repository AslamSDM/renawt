# Build stage (stays on a plain Node image for compilation)
FROM node:20-slim AS builder

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

WORKDIR /app

COPY package.json ./
RUN corepack enable && npm install --legacy-peer-deps

COPY tsconfig.json ./
COPY src ./src
RUN npx tsc
RUN npm prune --production --legacy-peer-deps

# Final stage — NVIDIA CUDA runtime base with GPU-accelerated Chromium
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04

# Install Node 20, Chromium, ffmpeg, fonts, and NVIDIA/Mesa GL driver libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    chromium \
    ffmpeg \
    fonts-liberation \
    fonts-noto-color-emoji \
    fonts-noto-cjk \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libxshmfence1 \
    libgl1-mesa-dri \
    libgl1-mesa-glx \
    mesa-utils \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# GPU passthrough flags for headless Chromium WebGL
ENV CHROMIUM_FLAGS="--no-sandbox --disable-setuid-sandbox --use-gl=desktop --ignore-gpu-blocklist --enable-webgl --disable-gpu-sandbox"
ENV PORT=4002

WORKDIR /app

# Copy production dependencies and built code
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./

# Copy shared Remotion components
COPY components ./components

# Create temp directories
RUN mkdir -p /app/.remotion-temp /app/public/renders /app/public/audio && chown -R node:node /app

USER node

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:4002/health || exit 1

EXPOSE 4002
CMD ["node", "dist/server.js"]