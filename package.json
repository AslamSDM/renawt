{
  "name": "remawt-monorepo",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter @remawt/web dev",
    "dev:engine": "pnpm --filter @remawt/engine dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @remawt/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @remawt/db generate",
    "db:migrate": "pnpm --filter @remawt/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @remawt/db migrate:dev"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
