{
  "name": "@remawt/engine",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:offline": "tsx scripts/smoke.ts --offline"
  },
  "dependencies": {
    "@remawt/db": "workspace:*",
    "@remawt/shared": "workspace:*",
    "@remawt/hf-kit": "workspace:*",
    "@remawt/publisher": "workspace:*",
    "@remawt/radar": "workspace:*",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "jose": "^6.1.3",
    "zod": "^4.3.6",
    "@mastra/core": "1.79.0",
    "@mastra/pg": "1.32.0",
    "@mastra/inngest": "1.10.7",
    "inngest": "4.26.1",
    "@mastra/observability": "1.22.0",
    "@mastra/posthog": "1.4.4",
    "@aws-sdk/client-s3": "3.1158.0",
    "jsonrepair": "3.15.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "24.19.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "hyperframes": "0.8.212"
  }
}
