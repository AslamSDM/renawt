    "@remawt/hf-kit": "workspace:*",
    "@remawt/publisher": "workspace:*",
    "@remawt/radar": "workspace:*",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "jose": "^6.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
